<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Local" value="C:\Development Products\NugetPackages\DataArc" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="Local">
      <package pattern="DataArc.*" />
    </packageSource>

    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>